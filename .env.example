# The fee-payer account this facilitator settles from.
# Get a free funded testnet account at https://portal.hedera.com/
HEDERA_FACILITATOR_ID=0.0.xxxxxxx
HEDERA_FACILITATOR_KEY=

# hedera:testnet or hedera:mainnet — must match the funded account above.
HEDERA_FACILITATOR_NETWORK=hedera:testnet

# Port the facilitator HTTP server listens on.
PORT=4021

# --- Only needed for scripts/test-payment.ts ---
# A second funded testnet account to act as the paying agent.
PAYER_ACCOUNT_ID=
PAYER_PRIVATE_KEY=
