# The fee-payer account this facilitator settles from.
# Get a free funded testnet account at https://portal.hedera.com/
HEDERA_FACILITATOR_ID=0.0.xxxxxxx
HEDERA_FACILITATOR_KEY=

# hedera:testnet or hedera:mainnet — must match the funded account above.
HEDERA_FACILITATOR_NETWORK=hedera:testnet

# Port the facilitator HTTP server listens on.
PORT=4021

# --- Only needed for scripts/test-payment.ts ---
# A second funded testnet account to act as the paying agent.
PAYER_ACCOUNT_ID=
PAYER_PRIVATE_KEY=

# --- Live demo (src/demo) ---
# The "agent" that auto-pays for quotes on the demo page. Isolated
# small-balance testnet account — never the real fee-payer. Mint one with
# scripts/mint-payer.ts.
DEMO_AGENT_ID=
DEMO_AGENT_KEY=

# The "merchant" resource server's revenue account — deliberately distinct
# from HEDERA_FACILITATOR_ID. Also minted with scripts/mint-payer.ts.
DEMO_MERCHANT_ID=
DEMO_MERCHANT_KEY=

# Price per quote call, in tinybars (1 HBAR = 100,000,000 tinybars).
DEMO_PRICE_TINYBARS=1000000

# Optional: demo-only HTS fungible token mirroring USDC's shape (6
# decimals). Not Circle's real testnet USDC. Mint with
# scripts/mint-demo-usdc.ts, then paste the printed token id here.
DEMO_USDC_TOKEN_ID=
DEMO_USDC_PRICE=10000
