# Turn a chain on by setting its key. At least one is required.

# Hedera
HEDERA_FACILITATOR_ID=0.0.12345
HEDERA_FACILITATOR_KEY=
HEDERA_NETWORK=hedera:testnet

# EVM - one key, any EVM chains viem knows. Needs native gas on each.
EVM_FACILITATOR_KEY=
EVM_NETWORKS=eip155:84532
# EVM_RPC_URL_84532=https://sepolia.base.org

# Solana - base58 secret or a JSON byte array. Needs SOL.
SOLANA_FACILITATOR_KEY=
SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=

# Storage: SQLite at ./data/facilitator.db unless DATABASE_URL is set.
# DATABASE_URL=postgres://...
# SQLITE_PATH=./data/facilitator.db

# Guards
MIN_AMOUNT_ATOMIC=0
PAY_TO_ALLOWLIST=
RATE_LIMIT_PER_MINUTE=120

PORT=3000
