{
  "name": "amnt-x402-facilitator",
  "version": "1.0.0",
  "description": "An open-source x402 payment facilitator for Hedera, EVM chains and Solana: verify, settle, log, discovery list and a dashboard.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/BelgacemElbar/amnt-x402-facilitator.git" },
  "homepage": "https://www.amnt.io/facilitators/hedera-x402-facilitator",
  "keywords": ["x402", "facilitator", "hedera", "base", "solana", "usdc", "payments"],
  "bin": { "amnt-x402-facilitator": "bin/amnt-x402-facilitator.mjs" },
  "exports": { ".": "./src/app.ts" },
  "files": ["src", "bin", "README.md", "LICENSE", ".env.example"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node bin/amnt-x402-facilitator.mjs",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e:testnet": "tsx scripts/e2e-testnet.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@solana/kit": "^5.5.1",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.24.0",
    "@x402/hedera": "^2.21.0",
    "@x402/svm": "^2.21.0",
    "dotenv": "^16.4.0",
    "hono": "^4.13.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.0",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
