{
  "name": "hedera-x402-facilitator",
  "version": "0.1.0",
  "description": "A minimal, self-hostable x402 payment facilitator for Hedera — verify and settle HBAR/HTS payments for any x402 resource server, on testnet or mainnet.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:payment": "tsx scripts/test-payment.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@x402/core": "2.19.0",
    "@x402/fetch": "2.19.0",
    "@x402/hedera": "2.19.0",
    "@x402/hono": "^2.19.0",
    "dotenv": "^16.4.0",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
